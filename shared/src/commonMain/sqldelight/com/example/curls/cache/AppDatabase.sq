import kotlin.Boolean;

CREATE TABLE Muscle (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    nameEn TEXT,
    isFront INTEGER AS Boolean NOT NULL,
    imageUrlMain TEXT,
    imageUrlSecondary TEXT
);

CREATE TABLE Category (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

CREATE TABLE Equipment (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

CREATE TABLE Exercise (
    id INTEGER NOT NULL PRIMARY KEY,
    categoryId INTEGER NOT NULL,
    FOREIGN KEY(categoryId) REFERENCES Category(id)
);

CREATE TABLE Image (
    id INTEGER NOT NULL PRIMARY KEY,
    exerciseId INTEGER NOT NULL,
    imageUrl TEXT NOT NULL,
    thumbnailSmall TEXT,
    thumbnailMedium TEXT,
    FOREIGN KEY(exerciseId) REFERENCES Exercise(id)
);

CREATE TABLE Translation (
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    exerciseId INTEGER NOT NULL,
    description TEXT,
    languageId INTEGER NOT NULL,
    FOREIGN KEY(exerciseId) REFERENCES Exercise(id) ON DELETE CASCADE
);

CREATE TABLE Video (
    id INTEGER NOT NULL PRIMARY KEY,
    exerciseId INTEGER NOT NULL,
    videoUrl TEXT NOT NULL,
    size INTEGER NOT NULL,
    duration TEXT,
    width INTEGER NOT NULL,
    height INTEGER NOT NULL,
    codec TEXT,
    codecLong TEXT,
    FOREIGN KEY(exerciseId) REFERENCES Exercise(id)
);

CREATE TABLE MuscleExerciseCrossRef (
    exerciseId INTEGER NOT NULL,
    muscleId INTEGER NOT NULL,
    PRIMARY KEY(exerciseId, muscleId),
    FOREIGN KEY(exerciseId) REFERENCES Exercise(id) ON DELETE CASCADE,
    FOREIGN KEY(muscleId) REFERENCES Muscle(id) ON DELETE CASCADE
);

CREATE TABLE MuscleSecondaryExerciseCrossRef (
    exerciseId INTEGER NOT NULL,
    muscleId INTEGER NOT NULL,
    PRIMARY KEY(exerciseId, muscleId),
    FOREIGN KEY(exerciseId) REFERENCES Exercise(id) ON DELETE CASCADE,
    FOREIGN KEY(muscleId) REFERENCES Muscle(id) ON DELETE CASCADE
);

CREATE TABLE EquipmentExerciseCrossRef (
    exerciseId INTEGER NOT NULL,
    equipmentId INTEGER NOT NULL,
    PRIMARY KEY(exerciseId, equipmentId),
    FOREIGN KEY(exerciseId) REFERENCES Exercise(id) ON DELETE CASCADE,
    FOREIGN KEY(equipmentId) REFERENCES Equipment(id) ON DELETE CASCADE
);

