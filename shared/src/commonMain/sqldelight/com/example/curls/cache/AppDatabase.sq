insertCategory:
INSERT OR REPLACE INTO Category(id, name)
VALUES (?, ?);

insertMuscle:
INSERT OR REPLACE INTO Muscle(id, name, nameEn, isFront, imageUrlMain, imageUrlSecondary)
VALUES (?, ?, ?, ?, ?, ?);

insertEquipment:
INSERT OR REPLACE INTO Equipment(id, name)
VALUES (?, ?);

selectAllCategories:
SELECT * FROM Category;

selectAllEquipment:
SELECT * FROM Equipment;

selectAllMuscles:
SELECT * FROM Muscle;

selectAllExercises:
SELECT * FROM Exercise;

selectAllImages:
SELECT * FROM Image;

selectAllTranslations:
SELECT * FROM Translation;

selectAllVideos:
SELECT * FROM Video;

selectAllMuscleCrossRefs:
SELECT * FROM MuscleExerciseCrossRef;

selectAllSecondaryMuscleCrossRefs:
SELECT * FROM MuscleSecondaryExerciseCrossRef;

selectAllEquipmentCrossRefs:
SELECT * FROM EquipmentExerciseCrossRef;

insertExercise:
INSERT OR REPLACE INTO Exercise(id, categoryId)
VALUES (?, ?);

insertTranslation:
INSERT OR REPLACE INTO Translation(id, name, exerciseId, description, languageId)
VALUES (?, ?, ?, ?, ?);

insertImage:
INSERT OR REPLACE INTO Image(id, exerciseId, imageUrl, thumbnailSmall, thumbnailMedium)
VALUES (?, ?, ?, ?, ?);

insertVideo:
INSERT OR REPLACE INTO Video(id, exerciseId, videoUrl, size, duration, width, height, codec, codecLong)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertMuscleCrossRef:
INSERT OR REPLACE INTO MuscleExerciseCrossRef(exerciseId, muscleId)
VALUES (?, ?);

insertMuscleSecondaryCrossRef:
INSERT OR REPLACE INTO MuscleSecondaryExerciseCrossRef(exerciseId, muscleId)
VALUES (?, ?);

insertEquipmentCrossRef:
INSERT OR REPLACE INTO EquipmentExerciseCrossRef(exerciseId, equipmentId)
VALUES (?, ?);
